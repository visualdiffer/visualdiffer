// the directory containing the visdiff target, used to prefix the paths below
VISDIFF_ROOT = visdiff

PRODUCT_BUNDLE_IDENTIFIER = com.visualdiffer.visdiff
PRODUCT_NAME = $(TARGET_NAME)
CREATE_INFOPLIST_SECTION_IN_BINARY = YES
SKIP_INSTALL = YES
REGISTER_APP_GROUPS = NO

INFOPLIST_FILE = $(VISDIFF_ROOT)/visdiff-Info.plist

// every binary shipped in a release must be sandboxed, the Sparkle configuration included, so this is
// set unconditionally instead of one line per configuration, which silently left Sparkle out
ENABLE_APP_SANDBOX = YES

// the sandbox above is useless without entitlements, so the two are kept together here
// unlike the values in Signing.local.xcconfig this path is neither secret nor machine specific
CODE_SIGN_ENTITLEMENTS = $(VISDIFF_ROOT)/visdiff.entitlements

AUTOMATION_APPLE_EVENTS = YES

#include "Signing.local.xcconfig"
#include "Versions.local.xcconfig"
